"sf_art_01_00" = "《光·遇》最初是作为《云》的续作而创建的。2012年，加利福尼亚圣莫尼卡，那家游戏公司办公室中，在不到十人的团队努力下，《光·遇》的故事开始了。";
"sf_art_01_01" = "《光·遇》的第一张概念图是一幅铅笔画，它描绘了一群孩子自由飞翔，孩子们的灵魂交织成光之神鸟的形状。\n陈星汉 绘";
"sf_art_01_02" = "《巨人》是《光·遇》的重要灵感来源，由美国艺术家N.C. Wyeth绘制。";
"sf_art_01_03" = "《小王子》的故事主题在《光·遇》早期开发中成为了参考之一。\n《小王子》 安东尼·德·圣-埃克苏佩里";
"sf_art_01_04" = "《迁徙的鸟》这部纪录片向我们展示了在长途飞行中，不同的条件对生存的影响。\n《迁徙的鸟》Jacques Perrin, Jacques Cluzaud, Michel Debats 导演";
"sf_art_02_00" = "“全景效应”是一段由太空站宇航员分享的，影响深远的视频。他们谈及凝视地球时的那种敬畏之情，这使得我们作为这颗小小的，蓝色星球的居民，紧密联结。";
"sf_art_02_01" = "在这里你可以看到《光·遇》的早期概念作品。";
"sf_art_03_00" = "在早期的艺术探索中，我们的第一批情感导图是基于“一个孩子飞向云端与巨人相遇”的想法。\n在这一阶段，我们还绘制了一些不同的可以飞越的岛屿。";
"sf_art_03_01" = "这些绘画展现出了丰富的想象力和孩子般的品质。\nJacky Ke Jiang 绘";
"sf_art_03_02" = "我们畅想了一条灵魂之路，孩子们在云层中遇到了奇幻的巨人和生物。\nJacky Ke Jiang 绘";
"sf_art_03_03" = "“可以在岛屿和海洋上自由翱翔的感觉”成为了重要的开发目标之一。\nYuichiro Tanabe 绘";
"sf_art_03_04" = "Yuichiro Tanabe 绘";
"sf_art_03_05" = "Tiffany Hayashi, Yuichiro Tanabe 绘";
"sf_art_04_00" = "我们意识到，“连接”将成为游戏玩法的核心要素。为此，我们制作了一个原型，测试不同的连接方式，其中就包括不同的玩家可以牵着彼此的手。\n这次测试也成为了我们游戏开发的一个重要里程碑。";
"sf_art_04_01" = "Yuichiro Tanabe, Jacky Ke Jiang 绘";
"sf_art_05_00" = "为了确定游戏的方向，我们试图在主题、音乐调性和情感上奠定《光·遇》的内核。\n当我们进入制作阶段时，我们决定《光·遇》将围绕着奇迹、人性和社区展开。";
"sf_art_05_01" = "Artwork by Tom Zhao";
"sf_art_05_02" = "Tom Zhao 绘";
"sf_art_05_03" = "Tom Zhao 绘";
"sf_art_06_00" = "最终我们确定了游戏的内核——奇迹、人性和社区。这也成为了我们简化艺术、设计和故事的方式。\n如果没有触及这些核心，那么它可能就不是《光·遇》的关键内容。";
"sf_art_06_01" = "奇迹。它的四周却笼罩着黑暗，但中心却充满安全感。\nTom Zhao 绘";
"sf_art_06_02" = "人性。每时每刻，感受来自陌生人的善意。\nTom Zhao 绘";
"sf_art_06_03" = "社区。在这里，你会感觉自己属于一个代表着同情和利他主义的集体。\nTom Zhao 绘";
"sf_art_07_00" = "在这里，您可以观看天空王国的早期艺术概念，以及情感发展的视觉氛围。";
"sf_art_07_01" = "晨岛-概念图\nYuichiro Tanabe 绘";
"sf_art_07_02" = "云野-概念图\nTom Zhao 绘";
"sf_art_07_03" = "雨林-概念图\nTom Zhao 绘";
"sf_art_07_04" = "霞谷-概念图\nTom Zhao 绘";
"sf_art_07_05" = "暮土-概念图\nKhang Le 绘";
"sf_art_07_06" = "禁阁-概念图\nJacky Ke Jiang 绘";
"sf_art_07_07" = "伊甸-概念图\nTrevor Stringer 绘";
"sf_art_07_08" = "重生概念图\nTom Zhao 绘";
"sf_art_07_09" = "重生之路概念图\nTom Zhao 绘";
"sf_art_08_00" = "在早期阶段，每个地图都有“动物守护者”照看着它们。随着时间的推移，这些守护者逐渐演变成了长老或先祖般的人物角色，在构思过程中，我们逐渐了解到它们在天空王国的兴衰中扮演了重要的角色。";
"sf_art_08_01" = "它们由一位统治者带领，最终牺牲了自己来推动新一代光之子的诞生。\nJacky Ke Jiang 绘";
"sf_art_08_02" = "晨岛-智慧\nTom Zhao 绘";
"sf_art_08_03" = "云野-同理心\nTom Zhao 绘";
"sf_art_08_04" = "雨林-坚韧\nTom Zhao 绘";
"sf_art_09_00" = "艺术团队探索了每个祖先与光之子相遇的关键叙事时刻……以及从视觉上捕捉这一瞬间，最具影响力的方式是什么。";
"sf_art_09_01" = "霞谷-超越\nTom Zhao 绘";
"sf_art_09_02" = "暮土-勇气\nTom Zhao 绘";
"sf_art_09_03" = "禁阁-信念\nTom Zhao 绘";
"sf_art_09_04" = "统治者-牺牲\nArtwork by Khang Le";
"sf_art_10_00" = "动画师将非长老的先祖们加入进来，并将游戏任务与以情感为中心的叙事相结合。这些先祖分布在各个地图上，与我们分享它们的记忆。";
"sf_art_10_01" = "在制定背景故事时，我们设想了不同文明的居民不断变化的原因。\nYuichiro Tanabe 绘";
"sf_art_10_02" = "Yuichiro Tanabe 绘";
"sf_art_10_03" = "Yuichiro Tanabe 绘";
"sf_art_10_04" = "居民们将“灵魂轮回”和“光”作为人与自然共存的一部分。\nYuichiro Tanabe 绘";
"sf_art_10_05" = "Yuichiro Tanabe 绘";
"sf_art_10_06" = "Jacky Ke Jiang, Tom Zhao 绘";
"sf_art_11_00" = "先祖们提供了过去文明的缩影。\n它们的记忆为每个地图提供了重要的质感和氛围，天空王国的每个角落都充满了亟待发现的故事。";
"sf_art_11_01" = "晨岛先祖-概念图\nYuichiro Tanabe 绘";
"sf_art_11_02" = "云野先祖-概念图\nYuichiro Tanabe 绘";
"sf_art_11_03" = "雨林先祖-概念图\nYuichiro Tanabe 绘";
"sf_art_11_04" = "霞谷先祖-概念图\nYuichiro Tanabe 绘";
"sf_art_11_05" = "暮土先祖-概念图\nYuichiro Tanabe 绘";
"sf_art_11_06" = "禁阁先祖-概念图\nYuichiro Tanabe 绘";
"sf_art_12_00" = "在设计玩家会遇到的生物时，我们考虑了更宽泛的星座和生命周期生态系统。在游戏世界中，一些线索表明了光和虚空在历史上对这些生物的影响。";
"sf_art_12_01" = "这些雄伟的生物将光引导回星空。我们设计时，希望它们以轻柔优雅的方式移动，就像水生生物在云层中游动一样。\nYuichiro Tanabe 绘";
"sf_art_12_02" = "艺术团队最初从鱼类设计开始，在后来的迭代中这些生物演变成了遥鲲。\nTom Zhao 绘";
"sf_art_13_00" = "在视觉上，我们将虚空作为叙事者，并尽可能中立地展示了它对生物影响，同时赞美了光之生物和暗之生物的美丽。\n通过中立、平等地尊重两种存在，我们得以描绘出一个更加丰富的世界。";
"sf_art_13_01" = "我们开始尝试使用颜色和形状来增强面对黑暗和虚空时的情绪。\nKhang Le 绘";
"sf_art_13_02" = "在这些艺术概念中，被虚空侵蚀的事物被描绘为黑水、黑暗植物、暗影蟹和冥龙.\nTom Zhao 绘";
"sf_art_14_00" = "虽然《光·遇》经历了许多次迭代，我们仍旧坚持了角色开放且可塑的外观。\n当然，为群体设计角色的同时，也需要考虑它们在屏幕上是否和谐美观。";
"sf_art_14_01" = "Jacky Ke Jiang 绘";
"sf_art_14_02" = "Yuichiro Tanabe 绘";
"sf_art_14_03" = "Jacky Ke Jiang 绘";
"sf_art_14_04" = "Jacky Ke Jiang 绘";
"sf_art_14_05" = "Yuichiro Tanabe 绘";
"sf_art_15_00" = "我们的目标是让角色可以代表任何类型的玩家。\n为此，我们并没有设计具体的面孔，而是使用了面具，这样你就可以选择自己的表情和外观。";
"sf_art_15_01" = "尽管这张图片是在2015年绘制的，但它预示了《光·遇》未来季节的艺术发展。\nYuichiro Tanabe 绘";
"sf_hist_01_00" = "陈星汉和南加州大学的同学Kellee Santiago一起完成了备受好评的毕业论文项目《云》之后，他们于2006年成立了独立工作室——那家游戏公司。";
"sf_hist_01_01" = "《云》，2005年，南加州大学";
"sf_hist_01_02" = "《流》，2007年，索尼计算机娱乐美国有限责任公司";
"sf_hist_01_03" = "《花》，2009年，索尼计算机娱乐美国有限责任公司";
"sf_hist_02_00" = "索尼计算机娱乐公司提供了三款游戏的发行，分别是《流》、《花》和《风之旅人》。\n\n这些游戏重新定义了创新，易上手，和正向引导的可能性。";
"sf_hist_02_01" = "《风之旅人》，2012年，索尼计算机娱乐美国有限责任公司";
"sf_hist_03_00" = "受到《风之旅人》获得“年度游戏”的认可，以及这款游戏将全球玩家联系起来的触动，工作室希望在下一个项目中倾注有关“感恩”和“社区”的主题。\n\n这成为了他们开发自发行作品《光·遇》的契机。";
"sf_hist_03_01" = "探索游戏设计";
"sf_hist_03_02" = "叙事&动画的头脑风暴";
"sf_hist_03_03" = "研讨新的设计概念";
"sf_hist_03_04" = "艺术概念规划";
"sf_hist_04_00" = "在最初几年的开发中，工作室通过探索和有趣的发现对设计进行了迭代。移动端的开发、免费开玩以及自主发行一个持续运营的线上游戏，对团队来说是巨大的挑战，这也使游戏的上线时间不得不推迟。";
"sf_hist_04_01" = "声音设计实验";
"sf_hist_04_02" = "环境艺术讨论";
"sf_hist_04_03" = "早期游戏开发";
"sf_hist_04_04" = "早期游戏开发";
"sf_hist_04_05" = "艺术团队研究了许多云的形状和状态，来帮助我们设计构成一个天空中的世界。";
"sf_hist_04_06" = "灵感来自云在一天中不同时间所传达的各种情感。";
"sf_hist_04_07" = "用于测试的早期原型。";
"sf_hist_04_08" = "制作了多个原型，来辅助规划云所构成的环境和飞行所需的技术和游戏引擎。";
"sf_hist_04_09" = "很明显，一旦置身于云层之间，我们不得不依赖于它们来建立情感基础和风景构成。";
"sf_hist_04_10" = "引入熟悉的环境。";
"sf_hist_04_11" = "《光·遇》中的人类世界。";
"sf_hist_04_12" = "用人类城市的天际线来测试飞行。";
"sf_hist_04_13" = "在天空王国对玩家进行了初步测试。";
"sf_hist_04_14" = "另一个例子是没有斗篷的玩家形象。";
"sf_hist_04_15" = "团队选择了这个早期设计，一个使用能量环来代表飞行能力的角色作为示意。";
"sf_hist_05_00" = "2016年底，三张独特的图片伴随着标语“有关给予的游戏”被发布。";
"sf_hist_05_01" = "《光·遇》的首批视觉海报。";
"sf_hist_06_00" = "在2017年秋季，《光·遇》在加州库比蒂诺的苹果特别活动上正式亮相，并首次登陆了iPhone和iPad的AppStore。\n\n游戏进行了封闭式测试，直到2019年7月19日正式发布。";
"sf_hist_06_01" = "陈星汉在苹果特别活动中进行演讲";
"sf_hist_06_02" = "团队推出了以冒险季节为主题的新形式，并引入了三个全新的季节。";
"sf_hist_06_03" = "每个季节都提供了全新的玩法、故事、角色、动作和物品。";
"sf_hist_06_04" = "这三个率先发布的季节分别是：“感谢季”、“追光季” 和 “归属季”。";
"sf_hist_06_05" = "<b>幕后故事：</b>2019年6月21日，《光·遇》正式上线苹果商店。";
"sf_hist_07_00" = "2020年，《光·遇》推出了四个新的冒险季节，并于7月9日正式上线了安卓平台。";
"sf_hist_07_01" = "音韵季";
"sf_hist_07_02" = "魔法季";
"sf_hist_07_03" = "圣岛季";
"sf_hist_07_04" = "预言季";
"sf_hist_07_05" = "<b>幕后故事：</b>其中两个季节本来会以其他命名来发布。你能猜出它们分别与哪个季节相关吗？\n\n季节1：聚集、苏醒、起源\n季节2：漫游、光辉、迁徙\n\n🕯️";
"sf_hist_08_00" = "2020年7月，《光·遇》迎来了第一个周年庆。这也是全球严重受到新冠疫情影响的一年。";
"sf_hist_08_01" = "《光·遇》的首个周年庆\n\n秘密基地第一次进行了派对装点，玩家们在此欢聚，共同庆祝生日。";
"sf_hist_08_02" = "";
"sf_hist_09_00" = "作为每个冒险季节的一部分，《光·遇》在整个天空王国不断地进行扩展，引入了新功能、更深入的故事、多人互动机制和独特的游戏玩法。";
"sf_hist_09_01" = "梦想季";
"sf_hist_09_02" = "集结季";
"sf_hist_09_03" = "小王子季\n\n在《光·遇》迎来第二个周年庆并登录到任天堂Switch平台的同时，还迎来了与奥利维尔·达加伊和安托万·德·圣·埃克絮佩里（Antoine de Saint-Exupéry）的倾情之作——《小王子》的首次IP合作。";
"sf_hist_09_04" = "风行季";
"sf_hist_09_05" = "<b>幕后花絮：</b> 你知道吗…？\n\n其实梦想季中原本还会加入一些其他角色：一位咖啡馆老板，一位吞火者表演者和一位竖琴师。";
"sf_hist_09_06" = "<b>幕后花絮：</b>在《小王子季》中，有关玫瑰的诗歌最初并不是叙事设计的一部分。\n\n然而在制作过程中，玫瑰的加入为这个季节带来了更深层的内涵。";
"sf_hist_10_00" = "《光·遇》的首个公益活动\n\n2021年6月，《光·遇》获得“蓝丝带海洋保护公益支持伙伴”证书，并组织玩家参与了系列线下公益净滩活动。";
"sf_hist_10_01" = "2021年，《光·遇》携手蓝丝带海洋保护协会，开展公益落地活动。";
"sf_hist_10_02" = "《光·遇》在5个城市举办了系列净滩公益，与上千旅人一同净化垃圾<b>1154.4</b>公斤。";
"sf_hist_10_03" = "《光·遇》项目组捐赠公益款项共计<b>50万元</b>，全部用于海洋保护公益活动的开展。";
"sf_hist_11_00" = "2022年，《光·遇》在索尼PlayStation平台发布，进一步壮大了《光·遇》的社区。\n\n在同一年，冒险季节引入了新的玩家能力，工作室宣布启动《光·遇》动画项目。";
"sf_hist_11_01" = "潜海季";
"sf_hist_11_02" = "表演季";
"sf_hist_11_03" = "破晓季";
"sf_hist_11_04" = "《光·遇》与备受全球喜爱的音乐艺术家欧若拉合作，并引入了新技术来帮助在游戏中演绎她的音乐。与此同时，我们举办了一场前所未有的多人线上音乐会。";
"sf_hist_11_05" = "2022年1月，《光·遇》实现了iOS和安卓平台的服务器互通，在大家的努力和期盼下，我们实现了“遇见亿人的温柔”。";
"sf_hist_12_00" = "随着《光·遇》的发展，工作室的研发和发行团队也在不断扩大，以推动游戏及其合作关系的发展。";
"sf_hist_12_01" = "《光·遇》迎来了三周年生日";
"sf_hist_12_02" = "2022年海洋节期间，《光·遇》陆续走进中山大学、厦门大学、广东海洋大学等高校，开展系列海龟保护科普讲座，宣传海洋保护知识，同时开展了“光遇与影皮影戏”创作分享活动，和玩家一同近距离接触非遗文化。";
"sf_hist_13_00" = "在四周年之际，《光·遇》团队和那家游戏公司依旧专注于开拓新的领域。\n\n此外，这一年还推出了四个新的季节。";
"sf_hist_13_01" = "追忆季";
"sf_hist_13_02" = "夜行季";
"sf_hist_13_03" = "拾光季";
"sf_hist_13_04" = "归巢季";
"sf_hist_13_05" = "2023年，《光·遇》继续开展系列海洋净滩公益，并参与了<b>中华鲟保护公益行动</b>，与玩家们共同支持长江生态保护。";
"sf_hist_14_00" = "《光·遇》希望在科隆国际游戏展期间刷新“全世界观众最多的虚拟世界音乐会”这一吉尼斯世界纪录。";
"sf_hist_14_01" = "这项挑战吉尼斯世界纪录的活动取得了巨大成功。\n\n《光·遇》不仅打破了世界记录，并在同一服务器上吸引了超过10000名用户同时在线。";
"sf_hist_15_00" = "《光·遇》以自己的风格庆祝五周年的到来，团队在成都举办线下嘉年华庆典，届时制作人陈星汉也抵达现场，与玩家深入探讨。";
"sf_hist_15_01" = "九色鹿季为天空王国带来了一个美好的传说和一位令人惊叹的角色。";
"sf_hist_15_02" = "2024年夏天出版的《光·遇》美术设定集回顾了七年的开发历程（2012-2019年）。";
"sf_hist_15_03" = "团队还推出了筑巢季。";
