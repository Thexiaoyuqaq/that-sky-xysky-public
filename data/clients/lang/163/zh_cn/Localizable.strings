"ap11_spirit_beckon_04" = "大人真是奇怪啊";
"ap11_spirit_gloating_01" = "有个崇拜者来探望我啦";
"ap11_spirit_gloating_02" = "我是这座岛上最优秀、穿的衣服最漂亮、最富裕和最聪明的人";
"ap11_spirit_gloating_03" = "但这里只有你一个人啊";
"ap11_spirit_gloating_04" = "请你崇拜我！";
"ap11_spirit_gloating_05" = "大人真是非常奇怪啊";
"ap11_spirit_scheme_01" = "你要这些星星干什么呢？";
"ap11_spirit_scheme_02" = "我拥有它们，五亿零一百多颗";
"ap11_spirit_scheme_03" = "拥有星星能给你带来什么好处呢？";
"ap11_spirit_scheme_04" = "它们让我变得富裕";
"ap11_spirit_scheme_05" = "变得富裕能给你带来什么好处呢？";
"ap11_spirit_scheme_06" = "买更多的星星";
"ap11_spirit_scheme_07" = "大人们真是都非常古怪啊";
"ap11_spirit_slouch_01" = "你为什么喝黑水？";
"ap11_spirit_slouch_02" = "为了忘记";
"ap11_spirit_slouch_03" = "忘记什么呀？";
"ap11_spirit_slouch_04" = "忘记我的羞愧";
"ap11_spirit_slouch_05" = "羞愧什么呢？";
"ap11_spirit_slouch_06" = "羞愧喝黑水啊！";
"ap11_spirit_slouch_07" = "大人真是非常、非常奇怪啊";
"ap11_spirit_sneeze_01" = "你好，你在看什么书？";
"ap11_spirit_sneeze_02" = "请别打扰我，我在研究一个从其他星球来的探险家";
"ap11_spirit_sneeze_03" = "大人们真有趣";
"ap11_spirit_stretch_01" = "你看起来很疲惫！你为什么总是要把路灯点亮呢？";
"ap11_spirit_stretch_02" = "这是点亮路灯的规定";
"ap11_spirit_stretch_03" = "但点亮后你为什么又把它熄灭呢？";
"ap11_spirit_stretch_04" = "这是熄灯的规定";
"ap11_spirit_stretch_05" = "那你可真倒霉";
"ap11_spirit_stretch_06" = "规定就是规定";
